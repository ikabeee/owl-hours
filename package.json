{
  "name": "owl-hours",
  "private": true,
  "version": "0.0.0",
  "description": "Zukki: AI agent for small local-service businesses (plumbers first). A person confirms every job.",
  "packageManager": "pnpm@10.0.0",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "test": "turbo run test",
    "test:api": "turbo run test --filter=@owl-hours/api",
    "test:owner": "turbo run test --filter=@owl-hours/owner",
    "test:shared": "turbo run test --filter=@owl-hours/shared",
    "test:db": "bash scripts/db-test.sh",
    "typecheck": "turbo run typecheck",
    "typecheck:api": "turbo run typecheck --filter=@owl-hours/api",
    "typecheck:owner": "turbo run typecheck --filter=@owl-hours/owner",
    "typecheck:shared": "turbo run typecheck --filter=@owl-hours/shared",
    "build": "turbo run build",
    "build:landing": "turbo run build --filter=@owl-hours/landing",
    "build:owner": "turbo run build --filter=@owl-hours/owner",
    "dev": "turbo run dev",
    "dev:api": "turbo run dev --filter=@owl-hours/api",
    "dev:api:local": "turbo run dev:local --filter=@owl-hours/api",
    "dev:landing": "turbo run dev --filter=@owl-hours/landing",
    "dev:owner": "turbo run dev --filter=@owl-hours/owner"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "turbo": "2.11.10",
    "typescript": "^7.0.2"
  }
}
