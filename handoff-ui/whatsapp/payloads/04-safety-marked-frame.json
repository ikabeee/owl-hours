{
  "messaging_product": "whatsapp",
  "recipient_type": "individual",
  "to": "{{customer_wa_id}}",
  "type": "interactive",
  "interactive": {
    "type": "button",
    "body": {
      "text": "Let's stop the water first: turn this valve clockwise. Any outlets or cables near the water?"
    },
    "action": {
      "buttons": [
        {
          "type": "reply",
          "reply": {
            "id": "safety_done",
            "title": "Done, no cables"
          }
        },
        {
          "type": "reply",
          "reply": {
            "id": "safety_cant_find",
            "title": "I can't find it"
          }
        }
      ]
    },
    "header": {
      "type": "image",
      "image": {
        "link": "{{marked_frame_url}}"
      }
    }
  }
}