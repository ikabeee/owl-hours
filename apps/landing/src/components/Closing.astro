---
// Closing panel and footer. Informational only: no sign-up, no Facebook Login.
---
<section class="closing" aria-labelledby="closing-title">
  <img src="/owl/jumping.webp" alt="Zukki jumping" width="160" height="173" />
  <h2 class="h2" id="closing-title">Zukki brings the request. You have the final word.</h2>
  <a class="btn btn--dark" href="#top">
    Back to top
    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><line x1="12" y1="19" x2="12" y2="5"></line><polyline points="5 12 12 5 19 12"></polyline></svg>
  </a>
  <footer class="footer">
    <span class="footer__brand">Zukki</span>
    <span>Made for the Meta Global AI Developer Hackathon 2026</span>
  </footer>
</section>

<style>
  .closing { background: var(--zk-night); color: var(--zk-on-dark); border-radius: var(--zk-r-panel); padding: 88px var(--zk-gutter) 32px; display: flex; flex-direction: column; align-items: center; gap: 28px; text-align: center; }
  .closing .h2 { max-width: 900px; }
  .footer { width: 100%; display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: 16px; margin-top: 48px; padding-top: 24px; border-top: 1px solid var(--zk-border-on-dark); font-size: 14px; color: var(--zk-on-dark-3); }
  .footer__brand { font-weight: 600; color: var(--zk-on-dark); }
</style>
