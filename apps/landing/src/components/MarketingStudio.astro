---
// "Zukki drafts. You approve." Step list + a story-style stage that loops Draft -> Edit -> Approve -> Publish (16s).
---
<section class="studio panel" id="studio" aria-labelledby="studio-title" data-scene="studio">
  <div class="studio__copy">
    <span class="eyebrow">Marketing Studio</span>
    <h2 class="h2" id="studio-title">Zukki drafts. You approve.</h2>
    <ol class="steps">
      <li class="l1">1&nbsp;&nbsp;Draft</li>
      <li class="l2">2&nbsp;&nbsp;Edit</li>
      <li class="l3">3&nbsp;&nbsp;Approve</li>
      <li class="l4">4&nbsp;&nbsp;Publish</li>
    </ol>
    <p class="studio__note">Zukki asks to publish only when you link your Page and Instagram. Unlink anytime.</p>
  </div>

  <div class="studio__visual">
    <div class="stage" role="img" aria-label="Animation: Zukki drafts a post, you edit the caption, approve it, and it is published to your Facebook Page and Instagram">
      <div class="progress" aria-hidden="true">
        <span><i class="p1"></i></span><span><i class="p2"></i></span><span><i class="p3"></i></span><span><i class="p4"></i></span>
      </div>
      <div class="stage__screens" aria-hidden="true">
        <div class="screen st1">
          <div class="row"><img src="/owl/avatar.png" alt="" width="28" height="28" /><b>New draft</b></div>
          <div class="photo">[Job photo]</div>
          <span class="skel" style="width: 92%"></span>
          <span class="skel" style="width: 64%"></span>
        </div>
        <div class="screen st2">
          <b>Edit the caption</b>
          <div class="photo"></div>
          <div class="field"><span class="typed">Midnight leak? Fixed by 7 AM.</span><span class="caret"></span></div>
        </div>
        <div class="screen screen--center st3">
          <img src="/owl/review.webp" alt="" width="120" height="130" />
          <span class="check"><svg width="34" height="34" viewBox="0 0 24 24" fill="none" stroke="#ffffff" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"></polyline></svg></span>
          <b class="big">Approved by you</b>
        </div>
        <div class="screen st4">
          <div class="row row--between"><b>Published</b><img src="/owl/jumping.webp" alt="" width="56" height="61" /></div>
          <div class="posts">
            <div class="post"><small>Facebook Page</small><span class="post__img"></span><span class="skel" style="width: 90%"></span></div>
            <div class="post"><small>Instagram</small><span class="post__img"></span><span class="skel" style="width: 70%"></span></div>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .studio { padding: 80px var(--zk-gutter); display: flex; flex-wrap: wrap; align-items: center; gap: 56px; }
  .studio__copy { flex: 1 1 400px; min-width: 0; display: flex; flex-direction: column; gap: 32px; }
  .studio__copy .h2 { margin-top: -16px; }
  .steps { list-style: none; margin: 0; padding: 0; display: flex; flex-direction: column; gap: 4px; }
  .steps li { font-family: var(--zk-font-display); font-size: 28px; font-weight: 600; line-height: 1.3; color: var(--zk-text-3); }
  .steps .l4 { color: var(--zk-text); } /* final state when motion is reduced */
  .l1 { animation: zkL1 16s linear infinite; }
  .l2 { animation: zkL2 16s linear infinite; }
  .l3 { animation: zkL3 16s linear infinite; }
  .l4 { animation: zkL4 16s linear infinite; }
  .studio__note { margin: 0; font-size: 15px; line-height: 1.5; color: var(--zk-text-2); max-width: 380px; }

  .studio__visual { flex: 1 1 380px; min-width: 0; display: flex; justify-content: center; }
  .stage { width: 100%; max-width: 360px; background: var(--zk-card); border-radius: var(--zk-r-panel); padding: 16px; box-shadow: var(--zk-shadow-1); display: flex; flex-direction: column; gap: 14px; }

  .progress { display: flex; gap: 6px; }
  .progress span { flex: 1 1 0; height: 4px; border-radius: 2px; background: var(--zk-track); overflow: hidden; }
  .progress i { display: block; height: 100%; background: var(--zk-text); transform-origin: left center; }
  .p1 { animation: zkP1 16s linear infinite; }
  .p2 { animation: zkP2 16s linear infinite; }
  .p3 { animation: zkP3 16s linear infinite; }
  .p4 { animation: zkP4 16s linear infinite; }

  .stage__screens { position: relative; height: 420px; }
  .screen { position: absolute; inset: 0; display: flex; flex-direction: column; gap: 12px; font-size: 14px; }
  .screen--center { align-items: center; justify-content: center; gap: 18px; text-align: center; }
  .st1, .st2, .st3 { opacity: 0; } /* reduced motion shows st4 only */
  .st1 { animation: zkS1 16s ease-in-out infinite; }
  .st2 { animation: zkS2 16s ease-in-out infinite; }
  .st3 { animation: zkS3 16s ease-in-out infinite; }
  .st4 { animation: zkS4 16s ease-in-out infinite; }

  .row { display: flex; align-items: center; gap: 8px; }
  .row img { border-radius: var(--zk-r-full); }
  .row--between { justify-content: space-between; }
  .row--between img { border-radius: 0; }
  .photo { flex: 1 1 auto; border-radius: 16px; background: var(--zk-border-strong); display: flex; align-items: center; justify-content: center; color: var(--zk-text-2); font-size: 13px; }
  .skel { height: 10px; border-radius: 5px; background: var(--zk-track); }

  .field { border: 1.5px solid var(--zk-text); border-radius: var(--zk-r-btn); padding: 12px; line-height: 1.4; display: flex; align-items: center; }
  .typed { display: inline-block; overflow: hidden; white-space: nowrap; animation: zkType 16s steps(28, end) infinite; }
  .caret { display: inline-block; width: 2px; height: 18px; margin-left: 1px; background: var(--zk-text); animation: zkCaret 1s step-end infinite; }

  .check { width: 72px; height: 72px; border-radius: var(--zk-r-full); background: var(--zk-accent); display: flex; align-items: center; justify-content: center; animation: zkPop 16s ease-out infinite; }
  .big { font-size: 18px; }

  .posts { flex: 1 1 auto; display: flex; gap: 10px; min-height: 0; }
  .post { flex: 1 1 0; min-width: 0; border: 1px solid var(--zk-border); border-radius: 14px; padding: 10px; display: flex; flex-direction: column; gap: 8px; }
  .post small { font-size: 12px; font-weight: 600; color: var(--zk-text-2); }
  .post__img { flex: 1 1 auto; border-radius: var(--zk-r-el); background: var(--zk-border-strong); }
  .post .skel { height: 8px; }
</style>
