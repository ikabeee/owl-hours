---
// "Three stops. One chat." A dot travels customer -> Zukki -> business (6s loop).
---
<section class="how" id="how" aria-labelledby="how-title">
  <h2 class="h2" id="how-title">Three stops. One chat.</h2>

  <div class="route" data-scene="route">
    <div class="route__line" aria-hidden="true"></div>
    <div class="route__rail" aria-hidden="true"><span class="route__dot"></span></div>
    <ol class="route__stops">
      <li>
        <span class="stop stop--1">
          <svg width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polygon points="23 7 16 12 23 17 23 7"></polygon><rect x="1" y="5" width="15" height="14" rx="2"></rect></svg>
        </span>
        <span class="stop__label">They send a video</span>
      </li>
      <li>
        <span class="stop stop--2">
          <img src="/owl/avatar.png" alt="" width="64" height="64" />
        </span>
        <span class="stop__label">Zukki picks you</span>
      </li>
      <li>
        <span class="stop stop--3">
          <svg width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M3 9l1.5-5h15L21 9"></path><path d="M3 9h18v2a3 3 0 0 1-6 0 3 3 0 0 1-6 0 3 3 0 0 1-6 0z"></path><path d="M5 13v8h14v-8"></path><path d="M10 21v-5h4v5"></path></svg>
        </span>
        <span class="stop__label">You accept and quote</span>
      </li>
    </ol>
  </div>

  <p class="how__note">No app for the customer. No bidding. One business at a time.</p>
</section>

<style>
  .how { padding: 88px var(--zk-gutter); display: flex; flex-direction: column; align-items: center; gap: 64px; text-align: center; }

  .route { position: relative; width: 100%; max-width: 960px; }
  .route__line { position: absolute; left: 44px; right: 44px; top: 44px; height: 2px; background: var(--zk-border-strong); }
  .route__rail { position: absolute; left: 44px; right: 44px; top: 44px; height: 0; }
  .route__dot { position: absolute; left: 0; top: 0; width: 18px; height: 18px; border-radius: var(--zk-r-full); background: var(--zk-accent); border: 4px solid var(--zk-bg); box-shadow: 0 2px 8px rgba(0,0,0,.18); transform: translate(-50%, -50%); animation: zkTravel 6s ease-in-out infinite; }

  .route__stops { position: relative; list-style: none; margin: 0; padding: 0; display: flex; justify-content: space-between; gap: 12px; }
  .route__stops li { width: 160px; display: flex; flex-direction: column; align-items: center; gap: 14px; }
  .stop { width: 88px; height: 88px; border-radius: var(--zk-r-full); background: var(--zk-panel); color: var(--zk-text); display: flex; align-items: center; justify-content: center; }
  .stop img { border-radius: var(--zk-r-full); }
  .stop--1 { animation: zkN1 6s ease-out infinite; }
  .stop--2 { animation: zkN2 6s ease-out infinite; }
  .stop--3 { background: var(--zk-text); color: var(--zk-on-dark); animation: zkN3 6s ease-out infinite; }
  .stop__label { font-size: 18px; font-weight: 600; }

  .how__note { margin: 0; font-size: 17px; color: var(--zk-text-2); }

  @media (max-width: 520px) {
    .route__stops li { width: 96px; }
    .stop__label { font-size: 15px; }
  }
</style>
