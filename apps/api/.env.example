# Copy to apps/api/.env (gitignored) and fill in. Never commit real values.
# Meta Model API key from dev.meta.ai
META_MODEL_API_KEY=
# Supabase project URL and service_role key (Project Settings > API).
# The service_role key bypasses RLS: server only, never in the owner app.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
# Publishable (anon) key: the API checks owner logins with it and runs
# owner queries as that user, so row-level security applies.
SUPABASE_ANON_KEY=
# Shared secret for /v1/internal (the WhatsApp side sends it as x-zukki-key).
# At least 32 characters, e.g. from: node -e "console.log(crypto.randomBytes(32).toString('base64url'))"
ZUKKI_SERVER_KEY=

# WhatsApp Cloud API (Meta app dashboard > WhatsApp > API Setup and
# Configuration). Leave blank to run without WhatsApp: the webhook answers
# 503 and nothing is sent. On a deployed server set these in the host's
# environment settings; share values through a password manager only.
# Access token: the temporary one expires in about a day; use a System User token.
WHATSAPP_ACCESS_TOKEN=
# The sending number's Phone Number ID (not the phone number itself).
WHATSAPP_PHONE_NUMBER_ID=
# For reference only; the API does not use it.
WHATSAPP_BUSINESS_ACCOUNT_ID=
# A secret we choose (16+ characters); type the same value in Meta's webhook settings.
WHATSAPP_VERIFY_TOKEN=
# Meta App Settings > Basic > App secret. Used for webhook signatures and
# Facebook Login/Graph API calls; keep it on the server only.
META_APP_SECRET=
# Meta App Settings > Basic > App ID.
META_APP_ID=
# Required to enable Facebook Login and Page posting. Set these to the public
# HTTPS API and owner-app origins; META redirect URI must be
# <API_PUBLIC_URL>/v1/meta/callback in the Meta app dashboard.
API_PUBLIC_URL=
OWNER_WEB_URL=
# Optional Facebook Login for Business configuration ID.
META_LOGIN_CONFIG_ID=
# Optional; defaults to the current Graph API version in the server config.
META_GRAPH_VERSION=
# Optional, defaults to v23.0.
WHATSAPP_GRAPH_VERSION=

# Server. PORT defaults to 3000; OUTBOX_POLL_MS (default 2000) is how often
# queued WhatsApp messages are sent, 0 turns sending off.
PORT=
OUTBOX_POLL_MS=

# Exact web origins allowed to call owner endpoints (comma-separated).
OWNER_APP_ORIGINS=
# External HTTPS API origin when deployed behind a TLS-terminating proxy.
OWNER_PUBLIC_ORIGIN=
